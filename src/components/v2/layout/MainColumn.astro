---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["v2-main-column", className]}>
  <slot />
</div>

<style>
  .v2-main-column {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .v2-main-column :global(.v2-table-scroll) {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
  }
</style>
