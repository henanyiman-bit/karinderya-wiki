---
import PageHeader from '../layout/PageHeader.astro';
import PageShell from '../layout/PageShell.astro';
import RelatedContent, { type RelatedContentItem } from '../../RelatedContent.astro';
import ResponsiveImage from '../../ResponsiveImage.astro';
import TableOfContents from '../../TableOfContents.astro';
import type { ResponsiveImageAsset } from '../../../data/images';

interface Props {
  title: string;
  intro?: string;
  kicker?: string;
  heroImage?: ResponsiveImageAsset;
  relatedLinks?: RelatedContentItem[];
  relatedHeading?: string;
  tableOfContents?: boolean;
  contentPanel?: boolean;
}

const {
  title,
  intro,
  kicker,
  heroImage,
  relatedLinks = [],
  relatedHeading = 'Related Content',
  tableOfContents = false,
  contentPanel = true,
} = Astro.props;
---

<PageShell
  sidebar={tableOfContents}
  sidebarAriaLabel="Page navigation"
  class="v2-directory-page"
>
  <PageHeader title={title} intro={intro} eyebrow={kicker}>
    {heroImage && (
      <ResponsiveImage
        slot="media"
        image={heroImage}
        priority
        sizes="(max-width: 760px) calc(100vw - 32px), 320px"
        class="v2-directory-page__image"
      />
    )}
  </PageHeader>

  <div
    id="directory-content"
    class:list={['v2-directory-page__content', { 'content-panel': contentPanel }]}
  >
    <slot />
  </div>

  <RelatedContent items={relatedLinks} heading={relatedHeading} />

  {tableOfContents && (
    <TableOfContents slot="sidebar" articleId="directory-content" />
  )}
</PageShell>

<style>
  .v2-directory-page {
    padding-block: var(--v2-space-4) var(--v2-space-9);
  }

  .v2-directory-page__content {
    min-width: 0;
  }

  .v2-directory-page__content :global(h2),
  .v2-directory-page__content :global(h3) {
    scroll-margin-top: var(--v2-sidebar-sticky-top);
  }

  .v2-directory-page__content :global(.card-grid) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  :global(.v2-directory-page__image) {
    overflow: hidden;
    border: 1px solid var(--v2-border-color);
    border-radius: var(--v2-radius-large);
    box-shadow: var(--v2-shadow-soft);
  }

  :global(.v2-directory-page__image img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 680px) {
    .v2-directory-page {
      padding-block: var(--v2-space-2) var(--v2-space-7);
    }

    .v2-directory-page__content :global(.card-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
