---
import PageHeader from '../layout/PageHeader.astro';
import PageShell from '../layout/PageShell.astro';
import AdSlot from '../../AdSlot.astro';
import RelatedContent, { type RelatedContentItem } from '../../RelatedContent.astro';
import ResponsiveImage from '../../ResponsiveImage.astro';
import TableOfContents from '../../TableOfContents.astro';
import WikiCard from '../../WikiCard.astro';
import type { ResponsiveImageAsset } from '../../../data/images';
import { normalizeAdCount, type AdCount } from '../../../utils/ad-policy';

interface CategoryCard {
  title: string;
  description: string;
  href?: string;
  icon?: string;
  status?: string;
}

interface Props {
  title: string;
  intro: string;
  kicker?: string;
  heroImage?: ResponsiveImageAsset;
  relatedLinks?: RelatedContentItem[];
  relatedHeading?: string;
  tableOfContents?: boolean;
  cards?: CategoryCard[];
  browseHeading?: string;
  copyHeading?: string;
  note?: string;
  adSlots?: boolean;
  adCount?: AdCount;
}

const {
  title,
  intro,
  kicker,
  heroImage,
  relatedLinks = [],
  relatedHeading = 'Related Content',
  tableOfContents = false,
  cards = [],
  browseHeading,
  copyHeading = 'About this section',
  note,
  adSlots = false,
  adCount,
} = Astro.props;
const hasDirectory = cards.length > 0;
const resolvedBrowseHeading = browseHeading ?? `Browse ${title}`;
const resolvedAdCount = normalizeAdCount(adCount, adSlots ? 3 : 2);
---

<PageShell
  sidebar={tableOfContents}
  sidebarAriaLabel="Page navigation"
  class="v2-category-hub"
>
  <PageHeader title={title} intro={intro} eyebrow={kicker}>
    {heroImage && (
      <ResponsiveImage
        slot="media"
        image={heroImage}
        priority
        sizes="(max-width: 760px) calc(100vw - 32px), 320px"
        class="v2-category-hub__image"
      />
    )}
  </PageHeader>

  {resolvedAdCount >= 1 && <AdSlot placement="after-intro" />}

  {hasDirectory ? (
    <div id="article-content" class="v2-category-hub__content">
      {note && <p class="notice">{note}</p>}
      <section class="section" aria-labelledby="browse-heading">
        <div class="section-heading">
          <div>
            <h2 id="browse-heading">{resolvedBrowseHeading}</h2>
            <p>Browse guides, databases, and related pages in this section.</p>
          </div>
        </div>
        <div class="card-grid">
          {cards.map((card) => <WikiCard {...card} />)}
        </div>
      </section>
      <section class="content-panel v2-category-hub__copy">
        <h2>{copyHeading}</h2>
        <slot />
      </section>
    </div>
  ) : (
    <article id="article-content" class="content-panel v2-category-hub__content">
      <slot />
    </article>
  )}

  {resolvedAdCount >= 2 && <AdSlot placement="before-related" />}
  <RelatedContent items={relatedLinks} heading={relatedHeading} />
  {resolvedAdCount >= 3 && <AdSlot placement="end-content" />}

  {tableOfContents && (
    <TableOfContents slot="sidebar" articleId="article-content" />
  )}
</PageShell>

<style>
  .v2-category-hub {
    padding-block: var(--v2-space-4) var(--v2-space-9);
  }

  :global(.v2-category-hub__image) {
    overflow: hidden;
    border: 1px solid var(--v2-border-color);
    border-radius: var(--v2-radius-large);
    box-shadow: var(--v2-shadow-soft);
  }

  :global(.v2-category-hub__image img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .v2-category-hub__content {
    min-width: 0;
  }

  .v2-category-hub__copy {
    margin-block: var(--v2-space-7);
  }

  .v2-category-hub__content :global(h2),
  .v2-category-hub__content :global(h3) {
    scroll-margin-top: var(--v2-sidebar-sticky-top);
  }

  .v2-category-hub__content :global(.card-grid) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 680px) {
    .v2-category-hub {
      padding-block: var(--v2-space-2) var(--v2-space-7);
    }

    .v2-category-hub__content :global(.card-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
