---
import PageHeader from '../layout/PageHeader.astro';import PageShell from '../layout/PageShell.astro';import RelatedContent,{type RelatedContentItem} from '../../RelatedContent.astro';import TableOfContents from '../../TableOfContents.astro';
interface Props{title:string;intro?:string;kicker?:string;relatedLinks?:RelatedContentItem[];tableOfContents?:boolean}
const{title,intro,kicker,relatedLinks=[],tableOfContents=false}=Astro.props;
---
<PageShell sidebar={tableOfContents} sidebarSticky={tableOfContents} sidebarAriaLabel="Page navigation" class="v2-update-article"><PageHeader title={title} intro={intro} eyebrow={kicker}/><article id="update-content" class="content-panel v2-update-article__content"><slot/></article><RelatedContent items={relatedLinks}/>{tableOfContents&&<TableOfContents slot="sidebar" articleId="update-content"/>}</PageShell>
<style>.v2-update-article{padding-block:var(--v2-space-3) var(--v2-space-7)}.v2-update-article__content{min-width:0}.v2-update-article__content :global(h2),.v2-update-article__content :global(h3){scroll-margin-top:var(--v2-sidebar-sticky-top)}.v2-update-article__content :global(code){overflow-wrap:anywhere;font-family:ui-monospace,SFMono-Regular,Consolas,monospace}</style>
