---
import PageHeader from '../layout/PageHeader.astro';
import PageShell from '../layout/PageShell.astro';
import EntityNavigation from '../../EntityNavigation.astro';
import RelatedContent, { type RelatedContentItem } from '../../RelatedContent.astro';
import ResponsiveImage from '../../ResponsiveImage.astro';
import TableOfContents from '../../TableOfContents.astro';
import AdSlot from '../../AdSlot.astro';
import type { ResponsiveImageAsset } from '../../../data/images';
import { normalizeAdCount, type AdCount } from '../../../utils/ad-policy';

interface Props {
  title: string;
  intro?: string;
  kicker?: string;
  heroImage?: ResponsiveImageAsset;
  relatedLinks?: RelatedContentItem[];
  relatedHeading?: string;
  previousPage?: RelatedContentItem;
  nextPage?: RelatedContentItem;
  tableOfContents?: boolean;
  adCount?: AdCount;
}

const {
  title,
  intro,
  kicker,
  heroImage,
  relatedLinks = [],
  relatedHeading = 'Related Content',
  previousPage,
  nextPage,
  tableOfContents = false,
  adCount,
} = Astro.props;

const hasQuickFacts = Astro.slots.has('quickFacts');
const resolvedAdCount = normalizeAdCount(adCount, 2);
---

<PageShell
  sidebar={tableOfContents}
  sidebarSticky={tableOfContents}
  sidebarAriaLabel="Page navigation"
  class="v2-entity-article"
>
  <PageHeader title={title} intro={intro} eyebrow={kicker}>
    {heroImage && (
      <ResponsiveImage
        slot="media"
        image={heroImage}
        priority
        sizes="(max-width: 760px) calc(100vw - 32px), 320px"
        class="v2-entity-article__image"
      />
    )}
  </PageHeader>

  {resolvedAdCount >= 1 && <AdSlot placement="after-intro" />}

  {hasQuickFacts && (
    <div class="v2-entity-article__facts">
      <slot name="quickFacts" />
    </div>
  )}

  <article id="entity-content" class="content-panel v2-entity-article__content">
    <slot />
  </article>

  {resolvedAdCount >= 2 && <AdSlot placement="before-related" />}

  <EntityNavigation previousPage={previousPage} nextPage={nextPage} />
  <RelatedContent items={relatedLinks} heading={relatedHeading} />

  {resolvedAdCount >= 3 && <AdSlot placement="end-content" />}

  {tableOfContents && (
    <TableOfContents slot="sidebar" articleId="entity-content" />
  )}
</PageShell>

<style>
  .v2-entity-article {
    padding-block: var(--v2-space-4) var(--v2-space-9);
  }

  .v2-entity-article__facts,
  .v2-entity-article__content {
    min-width: 0;
  }

  .v2-entity-article__facts {
    margin-block-end: var(--v2-space-5);
  }

  .v2-entity-article__content :global(h2),
  .v2-entity-article__content :global(h3) {
    scroll-margin-top: var(--v2-sidebar-sticky-top);
  }

  .v2-entity-article__content :global(.table-scroll) {
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  :global(.v2-entity-article__image) {
    overflow: hidden;
    border: 1px solid var(--v2-border-color);
    border-radius: var(--v2-radius-large);
    box-shadow: var(--v2-shadow-soft);
  }

  :global(.v2-entity-article__image img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 680px) {
    .v2-entity-article {
      padding-block: var(--v2-space-2) var(--v2-space-7);
    }
  }
</style>
