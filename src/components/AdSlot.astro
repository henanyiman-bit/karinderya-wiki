---
import AdsterraAdSlot from './ads/AdSlot.astro';
import type { AdSlotName } from '../config/ads';
import type { AdPlacement } from '../config/google';

interface Props {
  placement: AdPlacement | 'sidebar' | 'after-intro' | 'mid-content' | 'before-related' | 'end-content';
  class?: string;
}

const { placement, class: className = '' } = Astro.props;
const slotMap: Record<Props['placement'], AdSlotName> = {
  top: 'article-top',
  'content-1': 'article-mid',
  'content-2': 'article-mid',
  bottom: 'article-bottom',
  'desktop-sidebar': 'article-toc',
  sidebar: 'article-toc',
  'after-intro': 'article-top',
  'mid-content': 'article-mid',
  'before-related': 'article-mid',
  'end-content': 'article-bottom'
};
---

<div class={className}><AdsterraAdSlot slot={slotMap[placement]} /></div>
