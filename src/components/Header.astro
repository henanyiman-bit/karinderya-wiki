---
import Search from './Search.astro';
import { headerBrandNavigation, headerNavigation } from '../utils/navigation';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={headerBrandNavigation.href} aria-label="Karinderya Wiki home">
      <span class="brand-mark" aria-hidden="true">K</span>
      <span>
        <strong>Karinderya</strong>
        <small>Roblox Wiki</small>
      </span>
    </a>

    <div class="header-actions">
      <div class="nav-menu">
        <input id="nav-toggle" type="checkbox" aria-label="Toggle navigation" aria-controls="main-navigation" />
        <label for="nav-toggle" aria-hidden="true"><span></span><span></span><span></span></label>
        <nav id="main-navigation" aria-label="Main navigation">
          {headerNavigation.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
      <Search />
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid color-mix(in srgb, var(--border) 82%, transparent); background: color-mix(in srgb, var(--surface) 94%, transparent); backdrop-filter: blur(16px); box-shadow: 0 3px 18px rgb(55 38 28 / 5%); }
  .header-inner { width: min(1240px, calc(100% - 48px)); min-height: 82px; margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
  .header-actions { min-width: 0; display: flex; align-items: center; gap: 18px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: var(--ink); text-decoration: none; line-height: 1; }
  .brand-mark { display: grid; place-items: center; width: 44px; aspect-ratio: 1; border-radius: 13px; color: white; background: linear-gradient(145deg, #d3623c, var(--accent-dark)); font: 850 1.35rem/1 var(--font-heading); box-shadow: 0 7px 18px rgb(190 76 35 / 22%); }
  .brand strong, .brand small { display: block; }
  .brand strong { font: 820 1.08rem/1.1 var(--font-heading); letter-spacing: -.025em; }
  .brand small { margin-top: 5px; color: var(--muted); font-size: .7rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  .nav-menu input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .nav-menu label { display: none; }
  nav { display: flex; align-items: center; gap: 3px; }
  nav a { min-height: 46px; display: inline-flex; align-items: center; padding: 10px 11px; border-radius: 10px; color: var(--muted); font-size: .9rem; font-weight: 700; text-decoration: none; transition: color .18s ease, background .18s ease; }
  nav a:hover, nav a[aria-current='page'] { color: var(--accent-dark); background: var(--accent-soft); }
  nav a[aria-current='page'] { box-shadow: inset 0 0 0 1px rgb(198 83 46 / 10%); }
  @media (min-width: 961px) and (max-width: 1180px) {
    .header-inner { gap: 12px; }
    .header-actions { gap: 8px; }
    nav { gap: 1px; }
    nav a { padding-inline: 7px; font-size: .83rem; }
  }
  @media (max-width: 960px) {
    .header-inner { width: calc(100% - 32px); min-height: 68px; }
    .header-actions { flex-direction: row-reverse; gap: 8px; }
    .nav-menu label { width: 44px; height: 44px; display: grid; place-content: center; gap: 5px; border: 1px solid var(--border); border-radius: 10px; cursor: pointer; touch-action: manipulation; }
    .nav-menu label span { display: block; width: 19px; height: 2px; background: var(--ink); border-radius: 2px; }
    .nav-menu input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 2px; }
    .nav-menu nav { position: absolute; top: calc(100% + 1px); left: 0; right: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; padding: 14px 16px 18px; border-bottom: 1px solid var(--border); background: var(--surface); box-shadow: var(--shadow); }
    .nav-menu input:not(:checked) ~ nav { display: none; }
    nav a { min-height: 48px; padding: 12px; }
  }
</style>
