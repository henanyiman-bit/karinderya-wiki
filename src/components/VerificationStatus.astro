---
export type VerificationStatus = 'Official' | 'Community Verified' | 'Reported' | 'To be verified';
import { RESEARCH_CHECKED_DATE } from '../data/sources';

interface Props {
  status: VerificationStatus;
  lastChecked?: string;
  notes?: string;
  compact?: boolean;
}

const {
  status,
  lastChecked = RESEARCH_CHECKED_DATE,
  notes,
  compact = false,
} = Astro.props;
const statusClass = status.toLowerCase().replaceAll(' ', '-');
---

<aside class:list={['verification', statusClass, { compact }]} aria-label={`Verification status: ${status}`}>
  <div class="verification-heading">
    <span class="status-dot" aria-hidden="true"></span>
    <strong>{status}</strong>
  </div>
  {!compact && <p><span>Last checked:</span> {lastChecked}</p>}
  {notes && <p class="notes">{notes}</p>}
</aside>

<style>
  .verification { margin: 18px 0; padding: 14px 16px; border: 1px solid var(--border); border-left-width: 4px; border-radius: 10px; background: var(--surface); }
  .verification-heading { display: flex; align-items: center; gap: 8px; }
  .status-dot { width: 9px; height: 9px; flex: 0 0 auto; border-radius: 50%; background: #68737d; }
  strong { font-size: .86rem; }
  p { margin: 4px 0 0; color: var(--muted); font-size: .78rem; }
  p span { font-weight: 700; }
  .notes { max-width: 760px; }
  .official { border-left-color: #26734d; }
  .official .status-dot { background: #26734d; }
  .community-verified { border-left-color: #2869a8; }
  .community-verified .status-dot { background: #2869a8; }
  .reported { border-left-color: #b36a12; }
  .reported .status-dot { background: #b36a12; }
  .to-be-verified { border-left-color: #68737d; }
  .compact { display: inline-flex; align-items: center; margin: 0; padding: 5px 9px; border-left-width: 1px; border-radius: 999px; }
  .compact .verification-heading { gap: 6px; }
  .compact .status-dot { width: 7px; height: 7px; }
</style>
