---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageSEO } from '../utils/seo';
import AdSlot from './AdSlot.astro';

interface Props {
  pageId?: string;
  title?: string;
  description?: string;
  kicker?: string;
  relatedLinks?: { label: string; href: string }[];
  v2?: boolean;
  pageShell?: any;
  pageHeader?: any;
}

const {
  pageId,
  title,
  description,
  kicker = 'Karinderya Wiki',
  relatedLinks = [],
  v2 = false,
  pageShell: V2PageShell,
  pageHeader: V2PageHeader,
} = Astro.props;
const registrySEO = pageId ? getPageSEO(pageId) : undefined;
const resolvedTitle = registrySEO?.h1 ?? title?.trim();
const resolvedDescription = registrySEO?.description ?? description?.trim();

if (!resolvedTitle || !resolvedDescription) {
  throw new Error('InfoPage requires either a registered pageId or title and description.');
}

if (v2 && (!V2PageShell || !V2PageHeader)) {
  throw new Error('InfoPage v2 requires pageShell and pageHeader components.');
}
---

<BaseLayout pageId={pageId} title={title} description={description} breadcrumbs={[{ label: 'Home', href: '/' }, { label: resolvedTitle }]}>
  {v2 ? (
    <V2PageShell sidebar={false}>
      <div class="narrow">
        <V2PageHeader title={resolvedTitle} intro={resolvedDescription} eyebrow={kicker} />
        <AdSlot placement="after-intro" />
        <article class="content-panel"><slot /></article>
        <AdSlot placement="before-related" />
        {relatedLinks.length > 0 && (
          <nav class="related" aria-label="Related pages">
            <h2>Related pages</h2>
            <div>{relatedLinks.map((item) => <a href={item.href}>{item.label}</a>)}</div>
          </nav>
        )}
        <AdSlot placement="end-content" />
      </div>
    </V2PageShell>
  ) : (
    <div class="narrow">
      <header class="page-hero">
        <p class="kicker">{kicker}</p>
        <h1>{resolvedTitle}</h1>
        <p class="lead">{resolvedDescription}</p>
      </header>
      <AdSlot placement="after-intro" />
      <article class="content-panel"><slot /></article>
      <AdSlot placement="before-related" />
      {relatedLinks.length > 0 && (
        <nav class="related" aria-label="Related pages">
          <h2>Related pages</h2>
          <div>{relatedLinks.map((item) => <a href={item.href}>{item.label}</a>)}</div>
        </nav>
      )}
      <AdSlot placement="end-content" />
    </div>
  )}
</BaseLayout>

<style>
  .related { margin: 32px 0; }
  .related h2 { margin: 0 0 14px; font-size: 1.15rem; }
  .related div { display: flex; flex-wrap: wrap; gap: 8px; }
  .related a { min-height: 44px; display: inline-flex; align-items: center; padding: 8px 13px; border: 1px solid var(--border); border-radius: 999px; color: var(--accent-dark); background: var(--surface); font-size: .82rem; font-weight: 700; text-decoration: none; }
</style>
