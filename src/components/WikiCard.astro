---
interface Props {
  title: string;
  description: string;
  href?: string;
  icon?: string;
  eyebrow?: string;
  status?: string;
}

const { title, description, href, icon = '→', eyebrow } = Astro.props;
---

<article class="wiki-card">
  <div class="card-icon" aria-hidden="true">{icon}</div>
  <div class="card-copy">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h3>
      {href ? <a href={href}>{title}<span aria-hidden="true">↗</span></a> : title}
    </h3>
    <p>{description}</p>
  </div>
</article>

<style>
  .wiki-card { height: 100%; display: flex; gap: 17px; padding: 24px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); box-shadow: 0 5px 18px rgb(60 35 20 / 4%); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .wiki-card:hover { transform: translateY(-3px); border-color: #d8b9a8; box-shadow: var(--shadow); }
  .card-icon { flex: 0 0 auto; width: 46px; height: 46px; display: grid; place-items: center; border-radius: 13px; color: var(--accent-dark); background: linear-gradient(145deg, #fff5ef, var(--accent-soft)); font-size: 1.1rem; font-weight: 800; }
  .card-copy { min-width: 0; overflow-wrap: anywhere; }
  .eyebrow { display: block; margin-bottom: 5px; color: var(--accent-dark); font-size: .66rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  h3 { margin: 0; font-size: 1.12rem; line-height: 1.3; }
  h3 a { display: flex; justify-content: space-between; gap: 12px; color: var(--ink); text-decoration: none; }
  h3 a::after { position: absolute; content: ''; inset: 0; }
  h3 span { color: var(--accent); font-size: .9rem; }
  p { margin: 9px 0 0; color: var(--muted); font-size: .93rem; line-height: 1.58; }
  .wiki-card { position: relative; }
  .wiki-card:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgb(198 83 46 / 12%), var(--shadow); }
</style>
