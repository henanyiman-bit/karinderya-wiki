---
export interface RelatedContentItem {
  label: string;
  href: string;
  description?: string;
}

interface Props {
  items: RelatedContentItem[];
  heading?: string;
}

const { items, heading = 'Related Content' } = Astro.props;
---

{items.length > 0 && (
  <nav class="related-content" aria-label={heading}>
    <h2>{heading}</h2>
    <div class="related-grid">
      {items.map((item) => (
        <a href={item.href}>
          <strong>{item.label}</strong>
          <span>{item.description ?? `Continue to the ${item.label} page.`}</span>
          <b aria-hidden="true">→</b>
        </a>
      ))}
    </div>
  </nav>
)}

<style>
  .related-content { margin: 48px 0; }
  h2 { margin: 0 0 18px; font-size: 1.35rem; }
  .related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  a { min-width: 0; min-height: 146px; display: flex; flex-direction: column; padding: 20px; border: 1px solid var(--border); border-radius: var(--radius); color: var(--ink); background: var(--surface); box-shadow: 0 5px 18px rgb(60 35 20 / 4%); text-decoration: none; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  a:hover { transform: translateY(-3px); border-color: #d8b9a8; box-shadow: var(--shadow); }
  strong { font-size: 1rem; }
  span { margin-top: 8px; color: var(--muted); font-size: .86rem; line-height: 1.55; overflow-wrap: anywhere; }
  b { margin-top: auto; padding-top: 10px; color: var(--accent); }
  @media (max-width: 760px) { .related-grid { grid-template-columns: 1fr; } a { min-height: 0; } }
</style>
