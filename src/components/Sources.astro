---
import { getSources, type SourceId } from '../data/sources';

interface Props {
  ids: SourceId[];
}

const { ids } = Astro.props;
const sources = getSources(ids);
---

<section class="sources-panel" aria-labelledby="sources-heading">
  <div class="sources-heading">
    <div>
      <p class="eyebrow">Research notes</p>
      <h2 id="sources-heading">Sources &amp; Verification</h2>
    </div>
    <a class="method-link" href="/verification/">How verification works</a>
  </div>
  <p class="source-disclaimer">These records identify public evidence used for this page. Inclusion does not imply endorsement, and community sources are not official.</p>
  <div class="source-list">
    {sources.map((source) => (
      <article class="source-card">
        <div class="source-meta"><span>{source.sourceType}</span><small>Checked {source.checkedDate}</small></div>
        <h3>{source.sourceName}</h3>
        <p><strong>Supports:</strong> {source.supports}</p>
        {source.notes && <p class="source-note">{source.notes}</p>}
      </article>
    ))}
  </div>
</section>

<style>
  .sources-panel { margin: 32px 0; padding: clamp(20px, 4vw, 30px); border: 1px solid var(--border); border-radius: var(--radius); background: #f3eee9; }
  .sources-heading { display: flex; justify-content: space-between; align-items: end; gap: 18px; }
  .eyebrow { margin: 0 0 5px; color: var(--accent-dark); font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h2 { margin: 0; font-size: clamp(1.3rem, 3vw, 1.75rem); }
  .method-link { min-height: 44px; display: inline-flex; align-items: center; flex: 0 0 auto; color: var(--accent-dark); font-size: .8rem; font-weight: 750; }
  .source-disclaimer { max-width: 760px; margin: 10px 0 18px; color: var(--muted); font-size: .8rem; }
  .source-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .source-card { min-width: 0; padding: 16px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); }
  .source-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; color: var(--muted); font-size: .69rem; }
  .source-meta span { color: var(--accent-dark); font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  .source-card h3 { margin: 8px 0; font-size: 1rem; overflow-wrap: anywhere; }
  .source-card p { margin: 6px 0; color: var(--muted); font-size: .78rem; overflow-wrap: anywhere; }
  .source-card p strong { color: var(--ink); }
  .source-note { padding-top: 6px; border-top: 1px solid var(--border); }
  @media (max-width: 680px) { .source-list { grid-template-columns: 1fr; } .sources-heading { align-items: start; flex-direction: column; } }
</style>
