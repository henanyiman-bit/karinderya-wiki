---
import ContentPage from './ContentPage.astro';
import type { VerificationStatus as Status } from './VerificationStatus.astro';
import type { BreadcrumbItem } from './Breadcrumb.astro';
import type { SourceId } from '../data/sources';

interface DetailRow {
  label: string;
  value: string;
}

interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  kicker: string;
  intro: string;
  overview: string;
  parent: BreadcrumbItem;
  status: Status;
  statusNotes: string;
  observedData: DetailRow[];
  known: string[];
  unknown: string[];
  sourceIds: SourceId[];
  relatedLinks: LinkItem[];
  note?: string;
}

const props = Astro.props;
const details = props.observedData.filter((row) => row.value.trim().toLowerCase() !== 'to be verified');
---

<ContentPage
  title={props.title}
  description={props.description}
  kicker={props.kicker}
  intro={props.intro}
  parent={props.parent}
  sourceIds={props.sourceIds}
  relatedLinks={props.relatedLinks}
>
  <p>{props.overview}</p>

  {details.length > 0 && (
    <>
      <h2>Details</h2>
      <div class="table-scroll">
        <table class="entity-data">
          <tbody>{details.map((row) => <tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody>
        </table>
      </div>
    </>
  )}

  {props.known.length > 0 && (
    <section class="gameplay-details">
      <h2>Gameplay Information</h2>
      <ul>{props.known.map((item) => <li>{item}</li>)}</ul>
    </section>
  )}
</ContentPage>

<style>
  .entity-data { min-width: 460px; }
  .entity-data th { width: 42%; }
  .gameplay-details { margin-top: 30px; }
</style>
