---
import ContentPage from './ContentPage.astro';
import QuickFacts from './QuickFacts.astro';
import type { VerificationStatus as Status } from './VerificationStatus.astro';
import type { BreadcrumbItem } from './Breadcrumb.astro';
import type { SourceId } from '../data/sources';
import type { ResponsiveImageAsset } from '../data/images';
import type { RelatedContentItem } from './RelatedContent.astro';

interface DetailRow {
  label: string;
  value: string;
}

interface Props {
  title: string;
  description: string;
  kicker: string;
  intro: string;
  overview: string;
  parent?: BreadcrumbItem;
  parents?: BreadcrumbItem[];
  status?: Status;
  statusNotes?: string;
  observedData?: DetailRow[];
  known?: string[];
  unknown?: string[];
  sourceIds?: SourceId[];
  relatedLinks: RelatedContentItem[];
  previousPage?: RelatedContentItem;
  nextPage?: RelatedContentItem;
  note?: string;
  heroImage?: ResponsiveImageAsset;
  howToGet?: string[];
  howToUse?: string[];
  tips?: string[];
}

const props = Astro.props;
const details = (props.observedData ?? []).filter((row) => {
  const value = row.value.trim().toLowerCase();
  return value !== 'to be verified' && !row.label.toLowerCase().includes('ratio');
});
---

<ContentPage
  title={props.title}
  description={props.description}
  kicker={props.kicker}
  intro={props.intro}
  parent={props.parent}
  parents={props.parents}
  sourceIds={props.sourceIds}
  relatedLinks={props.relatedLinks}
  heroImage={props.heroImage}
  tableOfContents
  previousPage={props.previousPage}
  nextPage={props.nextPage}
>
  <h2 id="introduction">Introduction</h2>
  <p>{props.overview}</p>

  <QuickFacts facts={details} />

  {(props.howToGet?.length ?? 0) > 0 && (
    <section>
      <h2 id="how-to-get">How to Get</h2>
      <ul>{props.howToGet?.map((item) => <li>{item}</li>)}</ul>
    </section>
  )}

  {(props.howToUse?.length ?? 0) > 0 && (
    <section>
      <h2 id="how-to-use">How to Use</h2>
      <ul>{props.howToUse?.map((item) => <li>{item}</li>)}</ul>
    </section>
  )}

  {(props.tips?.length ?? 0) > 0 && (
    <section>
      <h2 id="gameplay-tips">Gameplay Tips</h2>
      <ul>{props.tips?.map((item) => <li>{item}</li>)}</ul>
    </section>
  )}
</ContentPage>
