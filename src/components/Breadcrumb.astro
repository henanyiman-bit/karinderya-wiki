---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props { items: BreadcrumbItem[]; }
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {index > 0 && <span class="separator" aria-hidden="true">/</span>}
        {item.href && index < items.length - 1
          ? <a href={item.href}>{item.label}</a>
          : <span aria-current={index === items.length - 1 ? 'page' : undefined}>{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs { margin: 22px 0 18px; }
  ol { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; padding: 0; margin: 0; list-style: none; color: var(--muted); font-size: .78rem; }
  li { display: inline-flex; gap: 7px; }
  a { min-height: 40px; display: inline-flex; align-items: center; color: var(--accent-dark); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .separator { color: #c6b8af; }
</style>
