---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { BreadcrumbItem } from './Breadcrumb.astro';
import TableOfContents from './TableOfContents.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import type { SourceId } from '../data/sources';
import type { ResponsiveImageAsset } from '../data/images';

interface RelatedLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  kicker?: string;
  intro: string;
  parent?: BreadcrumbItem;
  relatedLinks?: RelatedLink[];
  sourceIds?: SourceId[];
  tableOfContents?: boolean;
  heroImage?: ResponsiveImageAsset;
}

const {
  title,
  seoTitle,
  description,
  kicker = 'Karinderya Wiki',
  intro,
  parent,
  relatedLinks = [],
  tableOfContents = false,
  heroImage,
} = Astro.props;
const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  ...(parent ? [parent] : []),
  { label: title },
];
---

<BaseLayout title={title} seoTitle={seoTitle} description={description} breadcrumbs={breadcrumbs}>
  <div class:list={['container', 'article-wrap', { 'has-toc': tableOfContents }]}>
    <header class:list={['page-hero', { 'has-image': heroImage }]}>
      <div>
        <p class="kicker">{kicker}</p>
        <h1>{title}</h1>
        <p class="lead">{intro}</p>
      </div>
      {heroImage && <ResponsiveImage image={heroImage} priority sizes="(max-width: 760px) calc(100vw - 32px), 360px" class="content-hero-image" />}
    </header>
    <div class:list={['article-layout', { 'with-toc': tableOfContents }]}>
      {tableOfContents && <TableOfContents articleId="article-content" />}
      <article id="article-content" class="content-panel article-content"><slot /></article>
    </div>
    {relatedLinks.length > 0 && (
      <nav class="related" aria-label="Related pages">
        <h2>Related pages</h2>
        <div>{relatedLinks.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .article-wrap { max-width: 980px; }
  .article-wrap.has-toc { max-width: 1180px; }
  .page-hero.has-image { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 360px); align-items: center; gap: clamp(24px, 5vw, 56px); }
  :global(.content-hero-image) { overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  :global(.content-hero-image img) { aspect-ratio: 4 / 3; object-fit: cover; }
  .article-layout.with-toc { display: grid; grid-template-columns: minmax(0, 1fr) 240px; grid-template-areas: "article toc"; align-items: start; gap: 24px; }
  .article-layout.with-toc > .article-content { grid-area: article; }
  .article-layout.with-toc > :global(.toc-shell) { grid-area: toc; }
  .article-content :global(h2), .article-content :global(h3) { scroll-margin-top: 90px; }
  .article-content :global(code) { padding: 2px 6px; border-radius: 5px; color: var(--accent-dark); background: var(--accent-soft); font-weight: 750; }
  .article-content :global(.table-scroll) { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .article-content :global(.table-scroll table) { min-width: 620px; }
  .article-content :global(.fact-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 18px 0; }
  .article-content :global(.fact-card) { padding: 16px; border: 1px solid var(--border); border-radius: 12px; background: #fffaf5; }
  .article-content :global(.fact-card h3) { margin: 0 0 6px; font-size: 1rem; }
  .article-content :global(.fact-card p) { margin: 0; }
  .related { margin: 32px 0; }
  .related h2 { margin: 0 0 14px; font-size: 1.15rem; }
  .related div { display: flex; flex-wrap: wrap; gap: 8px; }
  .related a { min-height: 44px; display: inline-flex; align-items: center; padding: 8px 13px; border: 1px solid var(--border); border-radius: 999px; color: var(--accent-dark); background: var(--surface); font-size: .82rem; font-weight: 700; text-decoration: none; }
  .related a:hover { border-color: #dec3b4; background: var(--accent-soft); }
  @media (max-width: 900px) { .article-layout.with-toc { grid-template-columns: minmax(0, 1fr); grid-template-areas: "toc" "article"; } }
  @media (max-width: 760px) { .page-hero.has-image { grid-template-columns: minmax(0, 1fr); } :global(.content-hero-image img) { max-height: 340px; } }
  @media (max-width: 600px) { .article-content :global(.fact-grid) { grid-template-columns: 1fr; } }
</style>
