---
interface NavigationItem {
  label: string;
  href: string;
}

interface Props {
  previousPage?: NavigationItem;
  nextPage?: NavigationItem;
}

const { previousPage, nextPage } = Astro.props;
---

{(previousPage || nextPage) && (
  <nav class="entity-navigation" aria-label="Previous and next pages">
    {previousPage
      ? <a class="previous" href={previousPage.href}><small>Previous</small><strong><span aria-hidden="true">&lt;-</span> {previousPage.label}</strong></a>
      : <span aria-hidden="true"></span>}
    {nextPage && <a class="next" href={nextPage.href}><small>Next</small><strong>{nextPage.label} <span aria-hidden="true">-&gt;</span></strong></a>}
  </nav>
)}

<style>
  .entity-navigation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 30px 0; }
  a { min-width: 0; min-height: 76px; display: flex; flex-direction: column; justify-content: center; padding: 14px 17px; border: 1px solid var(--border); border-radius: var(--radius); color: var(--ink); background: var(--surface); text-decoration: none; }
  a:hover { border-color: #dec3b4; background: var(--accent-soft); }
  small { color: var(--muted); font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  strong { margin-top: 5px; overflow-wrap: anywhere; }
  strong span { color: var(--accent); }
  .next { grid-column: 2; text-align: right; }
  @media (max-width: 520px) { .entity-navigation { grid-template-columns: 1fr; }.next { grid-column: 1; text-align: left; } }
</style>
