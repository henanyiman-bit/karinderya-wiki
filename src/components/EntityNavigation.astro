---
interface NavigationItem {
  label: string;
  href: string;
}

interface Props {
  previousPage?: NavigationItem;
  nextPage?: NavigationItem;
}

const { previousPage, nextPage } = Astro.props;
---

{(previousPage || nextPage) && (
  <nav class="entity-navigation" aria-label="Previous and next pages">
    {previousPage
      ? <a class="previous" href={previousPage.href}><small>Previous</small><strong><span aria-hidden="true">←</span> {previousPage.label}</strong></a>
      : <span aria-hidden="true"></span>}
    {nextPage && <a class="next" href={nextPage.href}><small>Next</small><strong>{nextPage.label} <span aria-hidden="true">→</span></strong></a>}
  </nav>
)}

<style>
  .entity-navigation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 34px 0; }
  a { min-width: 0; min-height: 88px; display: flex; flex-direction: column; justify-content: center; padding: 17px 20px; border: 1px solid var(--border); border-radius: 16px; color: var(--ink); background: var(--surface); box-shadow: var(--v2-shadow-card, 0 10px 28px rgba(63,39,28,.07)); text-decoration: none; transition: border-color .18s ease, background .18s ease, transform .18s ease; }
  a:hover { transform: translateY(-1px); border-color: #dec3b4; background: var(--accent-soft); }
  a:focus-visible { outline: 3px solid color-mix(in srgb, var(--accent) 30%, transparent); outline-offset: 3px; }
  small { color: var(--muted); font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  strong { margin-top: 6px; font-size: .96rem; overflow-wrap: anywhere; }
  strong span { color: var(--accent); }
  .next { grid-column: 2; text-align: right; }
  @media (max-width: 520px) { .entity-navigation { grid-template-columns: 1fr; }.next { grid-column: 1; text-align: left; } }
</style>
