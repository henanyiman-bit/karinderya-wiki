<ContentPage
  title="Karinderya Tiles"
  description="Learn how Tiles fit into Karinderya decoration, surface customization, and restaurant layout planning."
  kicker="Decoration entry"
  intro="Tiles are part of the Decorations section and help define the visual treatment of restaurant surfaces."
  parent={{ label: 'Decorations', href: '/decorations/' }}
  relatedLinks={[
    { label: 'Decorations', href: '/decorations/' },
    { label: 'Furniture', href: '/furniture/' },
    { label: 'Restaurant Layout Guide', href: '/guides/restaurant-layout/' },
    { label: 'Counter Planning', href: '/guides/counter-upgrades/' },
