---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityArticle from '../../components/v2/templates/EntityArticle.astro';
import { siteImages } from '../../data/images';
import { getPageSEO } from '../../utils/seo';
const pageSEO = getPageSEO('decorations-tiles');
---

<BaseLayout pageId="decorations-tiles" breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Decorations', href: '/decorations/' }, { label: pageSEO.h1 }]}>
<EntityArticle
  title={pageSEO.h1}
  kicker="Decoration entry"
  intro="Tiles are documented as a Karinderya surface-customization feature. Current catalog details and effects are not established here."
  relatedLinks={[
    { label: 'Decorations', href: '/decorations/' },
    { label: 'Furniture', href: '/furniture/' },
    { label: 'Restaurant Layout Guide', href: '/guides/restaurant-layout/' },
    { label: 'Counter Planning', href: '/guides/counter-upgrades/' },
  ]}
  tableOfContents
  heroImage={siteImages.decorationsHero}
>
  <h2 id="overview">Overview</h2>
  <p>Tiles appear in dated Decorations Part 1 records as a restaurant customization feature. This page is intentionally limited to what those records support.</p>

  <h2 id="how-it-works">How It Works</h2>
  <p>The available Tile controls, designs, and acquisition terms should be read from the current game interface. The reviewed evidence does not establish a permanent catalog or a gameplay bonus.</p>

  <h2 id="usage">Usage</h2>
  <p>Use the Tiles entry when navigating surface-customization information. For broader visual planning, continue to the Decorations Hub or Restaurant Layout Guide.</p>

  <h2 id="gameplay-tips">Gameplay Tips</h2>
  <ul>
    <li>Choose a clear visual direction before changing multiple areas.</li>
    <li>Keep furniture placement and movement paths readable.</li>
    <li>Review the Decorations hub when looking for another customization topic.</li>
    <li>Use the Restaurant Layout Guide for broader space-planning help.</li>
  </ul>
  <h2 id="known-limitations">Known Limitations</h2>
  <p>This page does not publish a fixed item count, price, unlock requirement, or hidden effect because those details were not confirmed by creator-owned material or a current game capture reviewed for this rebuild.</p>
</EntityArticle>
</BaseLayout>
