---
import ContentPage from '../components/ContentPage.astro';
import { siteImages } from '../data/images';
---
<ContentPage title="Karinderya Food & Menu Groups" description="Browse Karinderya menu groups, dishes, and customer-count unlocks." kicker="Kitchen guide" intro="Browse menu groups, dishes, and customer-count milestones." relatedLinks={[{ label: 'Recipes', href: '/recipes/' }, { label: 'Ingredients', href: '/ingredients/' }, { label: 'Grocery', href: '/grocery/' }]} sourceIds={['codex-menu', 'wiki-menu']} heroImage={siteImages.foodHero}>
  <h2>Menu Groups</h2>
  <div class="table-scroll"><table><thead><tr><th scope="col">Menu group</th><th scope="col">Dishes or unlock</th></tr></thead><tbody>
    <tr><th scope="row">LUGAW</th><td>Plain and Goto</td></tr>
    <tr><th scope="row">SILOG MEALS</th><td>Unlocks at 100 customers</td></tr>
    <tr><th scope="row">SILOG MEALS 2</th><td>Unlocks at 400 customers</td></tr>
    <tr><th scope="row">LUTONG BAHAY</th><td>Unlocks at 670 customers</td></tr>
    <tr><th scope="row">PASTA SOSYAL</th><td>Unlocks at 1,994 customers</td></tr>
  </tbody></table></div>
</ContentPage>
