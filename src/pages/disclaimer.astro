---
import InfoPage from '../components/InfoPage.astro';
import PageHeader from '../components/v2/layout/PageHeader.astro';
import PageShell from '../components/v2/layout/PageShell.astro';
---
<InfoPage pageId="disclaimer" v2 pageShell={PageShell} pageHeader={PageHeader} kicker="Site policy" relatedLinks={[{ label: 'About', href: '/about/' }, { label: 'Contact', href: '/contact/' }, { label: 'Terms of Use', href: '/terms/' }]}>
  <h2>Unofficial fan resource</h2>
  <p>Karinderya Wiki is an unofficial fan-made resource and is not affiliated with Roblox Corporation or the Karinderya developers. It is not endorsed or sponsored by either party.</p>
  <h2>Game information changes</h2>
  <p>Codes, recipes, prices, worker data, equipment statistics, and update details can change as the game is updated. Check the current game interface before making important gameplay decisions.</p>
  <h2>No guarantees</h2>
  <p>The site is provided for general information and entertainment. We make no guarantee that every page is complete, error-free, or continuously available.</p>
</InfoPage>
