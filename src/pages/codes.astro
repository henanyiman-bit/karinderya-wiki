---
import ContentPage from '../components/ContentPage.astro';
import FAQ from '../components/FAQ.astro';
import { currentCodes } from '../data/codes';
import { siteImages } from '../data/images';

const faqItems = [
  { question: 'Why is my Karinderya code not working?', answer: 'Check capitalization and remove accidental spaces first. A code may also have been used already or may have expired after a game update.' },
  { question: 'Do Karinderya codes expire?', answer: 'Codes can expire or be removed after updates. If a code no longer works, check its spelling and whether you already redeemed it.' },
  { question: 'Where can new Karinderya codes appear?', answer: 'New codes may arrive alongside game updates. Check this page again when a new update is released.' },
];
---

<ContentPage
  title={'Karinderya Codes \u2013 Latest Working Codes & Rewards'}
  seoTitle="Karinderya Codes Guide & Rewards | Karinderya Wiki"
  description="Find the latest Karinderya Roblox codes, rewards, redemption steps, and update information."
  kicker="Rewards reference"
  intro="Browse current code strings, rewards, and redemption guidance."
  relatedLinks={[{ label: 'Beginner guide', href: '/guides/beginner-guide/' }, { label: 'Latest updates', href: '/updates/' }]}
  sourceIds={['roblox-game', 'codex-codes', 'destructoid-codes', 'nerdschalk-codes', 'wiki-decorations']}
  tableOfContents
  heroImage={siteImages.codesHero}
>
  <h2 id="active-codes">Active Codes</h2>
  <p>These are the latest codes included in the wiki. Code availability can change after game updates, and a code already used on an account cannot normally be redeemed again.</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th scope="col">Code</th><th scope="col">Reward</th></tr></thead>
      <tbody>
        {currentCodes.map((item) => (
          <tr>
            <th scope="row"><code>{item.code}</code></th>
            <td>{item.reward}{item.note && <small>{item.note}</small>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="expired-codes">Expired Codes</h2>
  <p>No expired codes are currently listed. If a code above stops working, first check its spelling and whether it was already redeemed. Availability can change without advance notice.</p>

  <h2 id="how-to-redeem-codes">How to Redeem Codes</h2>
  <ol>
    <li>Open Karinderya and locate the current code-redemption interface.</li>
    <li>Enter the code exactly as written, including capitalization, and remove spaces before or after the string.</li>
    <li>Submit the code once and read the message shown by the game.</li>
    <li>If it fails, check for a typing error or previous redemption before treating the code as potentially expired.</li>
  </ol>

  <h2 id="rewards-information">Rewards Information</h2>
  <p>Code rewards can include Cash, furniture, equipment, Concrete, and Cash Potions. Rewards are delivered by the game when a valid code is accepted.</p>

  <FAQ items={faqItems} />
</ContentPage>

<style>
  small { display: block; max-width: 420px; margin-top: 6px; color: var(--muted); }
</style>
