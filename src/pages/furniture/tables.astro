---
import ContentPage from '../../components/ContentPage.astro';
---
<ContentPage title="Karinderya Tables" description="Compare Karinderya table families, Cash prices, and resale examples." kicker="Furniture database" intro="Browse table options for upgrading your restaurant dining area." parent={{ label: 'Furniture', href: '/furniture/' }} relatedLinks={[{ label: 'Chairs', href: '/furniture/chairs/' }, { label: 'Furniture overview', href: '/furniture/' }, { label: 'Counter upgrades', href: '/guides/counter-upgrades/' }]} sourceIds={['wiki-furniture']}>
  <h2>Table Families</h2>
  <p>Plank, Wood, Red Wooden, Integrated, Elegant Wooden, Parsons, Slat-back, and Royal.</p>
  <h2>Cash Prices</h2>
  <div class="table-scroll"><table><thead><tr><th scope="col">Table</th><th scope="col">Buy price</th></tr></thead><tbody>
    <tr><th scope="row">Plank Table</th><td>&#8369;130</td></tr>
    <tr><th scope="row">Wood Table</th><td>&#8369;365</td></tr>
    <tr><th scope="row">Red Wooden Table</th><td>&#8369;415</td></tr>
  </tbody></table></div>
  <h2>Resale Examples</h2>
  <div class="table-scroll"><table><thead><tr><th scope="col">Table</th><th scope="col">Buy</th><th scope="col">Sell</th><th scope="col">Recovery</th></tr></thead><tbody>
    <tr><th scope="row">Plank Table</th><td>&#8369;130</td><td>&#8369;26</td><td>20%</td></tr>
    <tr><th scope="row">Wood Table</th><td>&#8369;365</td><td>&#8369;73</td><td>20%</td></tr>
  </tbody></table></div>
  <p class="notice">These examples show the resale values for the listed tables. Check an item's current sell value before replacing furniture.</p>
</ContentPage>
