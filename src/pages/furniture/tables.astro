---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WikiCard from '../../components/WikiCard.astro';
import DirectoryPage from '../../components/v2/templates/DirectoryPage.astro';
import { siteImages } from '../../data/images';
import { getPageSEO } from '../../utils/seo';

const tableEntries = [
  { title: 'Plank Table', description: 'Open the community-reported Plank Table entry and review its evidence boundary.', href: '/furniture/plank-table/', icon: 'P' },
  { title: 'Wood Table', description: 'Open the community-reported Wood Table entry.', href: '/furniture/wood-table/', icon: 'W' },
  { title: 'Red Wooden Table', description: 'Open the community-reported Red Wooden Table entry.', href: '/furniture/red-wooden-table/', icon: 'R' },
];
const pageSEO = getPageSEO('furniture-tables');
---

<BaseLayout pageId="furniture-tables" breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Karinderya Furniture', href: '/furniture/' }, { label: pageSEO.h1 }]}>
  <DirectoryPage
    title={pageSEO.h1}
    kicker="Furniture directory"
    intro="Browse the current Table pages while their exact names and current availability await stronger in-game confirmation."
    relatedLinks={[
      { label: 'Furniture Hub', href: '/furniture/', description: 'Browse Furniture categories and layout-planning information.' },
      { label: 'Chairs', href: '/furniture/chairs/', description: 'Continue to the Chairs category and dining-area guidance.' },
      { label: 'Restaurant Layout Guide', href: '/guides/restaurant-layout/', description: 'Plan customer, work, and movement areas across the restaurant.' },
    ]}
    heroImage={siteImages.furnitureHero}
    tableOfContents
  >
  <h2 id="introduction">Introduction</h2>
  <p>This directory preserves three existing Table URLs and community-reported names. It is not presented as a complete official table list.</p>

  <h2 id="overview">Overview</h2>
  <p>Open an entry to see what is known and what still needs confirmation. Price, seating capacity, rating effects, unlock conditions, and a complete official catalog are not established here.</p>

  <h2 id="how-tables-work">Current Table Pages</h2>
  <p>The names below remain useful navigation labels, but Tier 1 or Tier 2 evidence is still needed before treating them as a complete current database.</p>

  <h2 id="table-directory">Table Directory</h2>
  <div class="card-grid">{tableEntries.map((item) => <WikiCard {...item} />)}</div>

  <h2 id="usage-and-layout">Usage and Layout</h2>
  <p>Use tables as part of a clear dining-area plan. Consider the surrounding chairs, regular movement paths, and the connection between customer seating and restaurant service before changing an arrangement.</p>

  <h2 id="gameplay-tips">Gameplay Tips</h2>
  <ul>
    <li>Keep the table area visually separate from cooking and other work areas.</li>
    <li>Leave practical movement paths around the dining area.</li>
    <li>Open an individual table entry for item-focused navigation and related pages.</li>
    <li>Observe how the restaurant is used after adjusting part of the table arrangement.</li>
  </ul>
  </DirectoryPage>
</BaseLayout>
