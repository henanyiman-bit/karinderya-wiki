---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectoryPage from '../../components/v2/templates/DirectoryPage.astro';
import { siteImages } from '../../data/images';
import { getPageSEO } from '../../utils/seo';
const pageSEO = getPageSEO('furniture-chairs');
---

<BaseLayout pageId="furniture-chairs" breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Karinderya Furniture', href: '/furniture/' }, { label: pageSEO.h1 }]}>
  <DirectoryPage
    title={pageSEO.h1}
    kicker="Furniture category"
    intro="This directory preserves the Chairs topic while individual chair names and current options await reliable game evidence."
    relatedLinks={[
      { label: 'Furniture Hub', href: '/furniture/', description: 'Browse Furniture categories and restaurant-planning information.' },
      { label: 'Tables Directory', href: '/furniture/tables/', description: 'Browse the table entries currently available in the Wiki.' },
      { label: 'Restaurant Layout Guide', href: '/guides/restaurant-layout/', description: 'Plan customer, work, and movement areas across the restaurant.' },
    ]}
    heroImage={siteImages.furnitureHero}
    tableOfContents
  >
  <h2 id="what-we-know">What We Know About Chairs</h2>
  <p>Chairs are discussed as part of Karinderya seating and restaurant Furniture. The current Wiki does not yet have reliable game evidence for a complete chair catalog or individual chair details.</p>

  <h2 id="overview">Overview</h2>
  <p>This page remains a category entry rather than an item database. It connects the Furniture Hub with the Tables directory and Restaurant Layout Guide without creating unsupported chair entities.</p>

  <h2 id="furniture-and-seating">Furniture and Seating</h2>
  <p>Use the current game interface to determine which seating options are available in your version. The surrounding Tables and restaurant layout provide the context for placing seating.</p>

  <h2 id="verified-entries">Verified Chair Entries</h2>
  <p>No individual chair entry has enough independent evidence for publication in this directory yet. Names from older search metadata have therefore not been promoted into public entity pages.</p>

  <h2 id="related-furniture">Related Furniture</h2>
  <p>Browse the <a href="/furniture/tables/">Tables directory</a> for existing table entries, return to the <a href="/furniture/">Furniture Hub</a>, or use the <a href="/guides/restaurant-layout/">Restaurant Layout Guide</a> for space-planning guidance.</p>
  </DirectoryPage>
</BaseLayout>
