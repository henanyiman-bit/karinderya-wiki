---
import BaseLayout from '../layouts/BaseLayout.astro';
import WikiCard from '../components/WikiCard.astro';
import CategoryHub from '../components/v2/templates/CategoryHub.astro';
import { ingredientEntities } from '../data/entities';
import { siteImages } from '../data/images';
import { getPageSEO } from '../utils/seo';

const ingredientOrder = ['rice', 'eggs', 'vegetables', 'bangus', 'pork', 'beef', 'condiments'];
const ingredientDirectory = ingredientOrder
  .map((slug) => ingredientEntities.find((item) => item.slug === slug))
  .filter((item) => item !== undefined);
const pageSEO = getPageSEO('ingredients');
const relatedLinks = [
  { label: 'Beginner Guide', href: '/guides/beginner-guide/', description: 'Learn where ingredients fit into the complete restaurant service loop.' },
  { label: 'Recipe Guide', href: '/recipes/', description: 'Understand how ingredients connect with recipes, cooking, food, and orders.' },
  { label: 'Cooking and Serving Guide', href: '/guides/cooking-and-serving/', description: 'Follow ingredients through preparation and the customer-service workflow.' },
  { label: 'Food Guide', href: '/food/', description: 'Explore the wider food category and its connected Wiki sections.' },
];
---

<BaseLayout
  pageId="ingredients"
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: pageSEO.h1 }]}
>
  <CategoryHub
    title={pageSEO.h1}
    kicker="Ingredient hub"
    intro="Browse the Karinderya ingredient directory and open an individual entry for focused Wiki information."
    relatedLinks={relatedLinks}
    relatedHeading="Related Guides"
    heroImage={siteImages.ingredientsHero}
    tableOfContents
  >
  <h2 id="introduction">Introduction</h2>
  <p>This hub is the directory for individual ingredients currently covered by the Karinderya Wiki. It helps players find a named ingredient first, then move to the separate Grocery, Recipe, Food, or cooking guide when broader context is needed.</p>
  <p>Use the directory for information about a specific ingredient, the <a href="/recipes/">Recipe Guide</a> for preparation relationships, and the <a href="/food/">Food Guide</a> for the wider food category.</p>

  <h2 id="how-ingredients-work">How Ingredients Work</h2>
  <p>Ingredient entries sit between several separate Wiki topics:</p>
  <p><strong>Grocery → Ingredients → Recipes → Food → Orders</strong></p>
  <ul>
    <li><strong>Grocery</strong> covers sourcing and management questions.</li>
    <li><strong>Ingredients</strong> provides the individual item directory.</li>
    <li><strong>Recipes</strong> covers documented preparation relationships.</li>
    <li><strong>Food</strong> covers prepared restaurant items.</li>
    <li><strong>Orders</strong> are handled in the task-focused cooking and serving guide.</li>
  </ul>

  <h2 id="featured-content">Featured Content</h2>
  <div class="card-grid">
    <WikiCard title="Ingredient Directory" description="Browse every individual ingredient entry currently available in the Wiki." href="#ingredient-directory" icon="I" />
    <WikiCard title="Recipe Guide" description="Learn how ingredients connect with cooking, food, and customer orders." href="/recipes/" icon="R" />
    <WikiCard title="Grocery Guide" description="Open the Grocery section used for ingredient-management information." href="/grocery/" icon="G" />
  </div>

  <h2 id="ingredient-directory">Ingredient Directory</h2>
  <p>Select an ingredient to open its individual Wiki entry and find the related cooking sections.</p>
  <div class="card-grid">
    {ingredientDirectory.map((item) => {
      const name = item.title.replace('Karinderya ', '');
      return <WikiCard title={name} description={`Open the ${name} ingredient entry.`} href={`/ingredients/${item.slug}/`} icon={name.charAt(0)} />;
    })}
  </div>

  <h2 id="grocery-and-ingredient-flow">Grocery and Ingredient Flow</h2>
  <p>Use the Grocery Guide when ingredient supplies need attention, then open the Ingredient Directory to identify the item and its connected Wiki information. The Recipe Guide continues from ingredients into preparation, while the Food Guide explains where prepared food fits into restaurant service.</p>
  <p>During an order, keep the ingredient information connected with the request being handled. Moving between these pages by purpose makes it easier to find the relevant information without mixing Grocery, Recipe, and Food topics together.</p>

  <h2 id="gameplay-tips">Gameplay Tips</h2>
  <ul>
    <li>Identify the ingredient shown by the current restaurant task before opening an individual entry.</li>
    <li>Use the Ingredient Directory for item-focused information and the Recipe Guide for preparation context.</li>
    <li>Keep ingredient information organized around the order currently being handled.</li>
    <li>Use the Grocery Guide when the restaurant needs supplies and the Food Guide for prepared menu information.</li>
    <li>Return to the Cooking and Serving Guide when you need the complete customer-service workflow.</li>
  </ul>
  </CategoryHub>
</BaseLayout>
