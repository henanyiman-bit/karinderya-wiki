---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpdatesDirectory from '../components/v2/templates/UpdatesDirectory.astro';
import { siteImages } from '../data/images';
import { getPageSEO } from '../utils/seo';
---
<BaseLayout pageId="updates" breadcrumbs={[{label:'Home',href:'/'},{label:getPageSEO('updates').h1}]}><UpdatesDirectory title={getPageSEO('updates').h1} kicker="Update history" intro="Browse dated Karinderya update records without treating unverified feature reports as official patch notes." relatedLinks={[{ label: 'Decorations', href: '/decorations/' }, { label: 'Codes', href: '/codes/' }, { label: 'Guides', href: '/guides/' }]} heroImage={siteImages.updatesHero}>
  <h2 id="documented-updates">Documented Updates</h2>
  <h3>Decorations Part 1</h3>
  <p>This record covers the customization features reported around the August 29, 2026 Roblox experience update. Individual claims are separated by evidence strength rather than presented as a complete creator patch note.</p>
  <p><a href="/updates/decorations-part-1/">Read the Decorations Part 1 update record</a>.</p>
  <h2 id="verification-method">How Update Records Are Checked</h2>
  <p>Update dates are tied to Roblox timestamps or dated creator-owned material where available. Feature details require a creator announcement or reviewable gameplay record. If only a feature name is supported, this Wiki does not infer its mechanics, price, or effect.</p>
  <h2 id="related-sections">Related Wiki Sections</h2>
  <p>Use <a href="/decorations/">Decorations</a> for the customization system, <a href="/codes/">Codes</a> for currently listed code strings, and the <a href="/guides/">Guides directory</a> for task-focused help.</p>
</UpdatesDirectory></BaseLayout>
