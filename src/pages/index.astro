---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import WikiCard from '../components/WikiCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import HomePortal from '../components/v2/templates/HomePortal.astro';
import { siteImages } from '../data/images';

const categories = [
  { title: 'Food & Recipes', description: 'Browse food, recipe, ingredient, and cooking information.', href: '/food/', icon: 'F' },
  { title: 'Workers', description: 'Explore the Worker system and related management guides.', href: '/workers/', icon: 'W' },
  { title: 'Equipment', description: 'Browse equipment categories, Stoves, the Chiller, and the cooking workflow.', href: '/equipment/', icon: 'E' },
  { title: 'Grocery & Ingredients', description: 'Find ingredient sourcing and management information.', href: '/grocery/', icon: 'G' },
  { title: 'Furniture', description: 'Browse Furniture categories, Tables, Chairs, and layout-planning guidance.', href: '/furniture/', icon: 'T' },
  { title: 'Decorations', description: 'Explore Tiles, counters, and Choopy Mystery Box information.', href: '/decorations/', icon: 'D' },
];
const guides = [
  { title: 'Beginner Guide', description: 'Learn the service loop and the main restaurant systems.', href: '/guides/beginner-guide/', icon: '1' },
  { title: '5-Star Guide', description: 'Improve restaurant service while working toward five stars.', href: '/guides/5-star-guide/', icon: '5' },
  { title: 'Counter Guide', description: 'Review the current Wiki information about counter changes.', href: '/guides/counter-upgrades/', icon: 'C' },
];
const startHere = [
  { step: '01', title: 'Beginner Guide', description: 'Learn the core restaurant loop and plan your first steps.', href: '/guides/beginner-guide/' },
  { step: '02', title: 'Cooking & Recipes', description: 'Understand food, ingredients, recipes, and customer orders.', href: '/recipes/' },
  { step: '03', title: 'Equipment Guide', description: 'Explore equipment categories, Stoves, the Chiller, and cooking workflow.', href: '/equipment/' },
  { step: '04', title: 'Workers', description: 'Learn how workers fit into restaurant operations.', href: '/workers/' },
  { step: '05', title: 'Furniture & Customization', description: 'Browse furniture and decorations for your restaurant.', href: '/furniture/' },
];
const wikiDirectory = [
  {
    title: 'Guides',
    icon: 'G',
    description: 'Walkthroughs for restaurant operations, shopping, layout, and customization.',
    links: [
      { label: 'Beginner Guide', href: '/guides/beginner-guide/' },
      { label: '5-Star Guide', href: '/guides/5-star-guide/' },
      { label: 'Counter Upgrades', href: '/guides/counter-upgrades/' },
      { label: 'Shop Restock', href: '/guides/shop-restock/' },
      { label: 'Furniture Planning', href: '/guides/restaurant-layout/' },
    ],
  },
  {
    title: 'Cooking',
    icon: 'C',
    description: 'Explore the food and ingredient systems used in restaurant service.',
    links: [
      { label: 'Food', href: '/food/' },
      { label: 'Recipes', href: '/recipes/' },
      { label: 'Ingredients', href: '/ingredients/' },
      { label: 'Grocery', href: '/grocery/' },
    ],
  },
  {
    title: 'Equipment',
    icon: 'E',
    description: 'Browse kitchen equipment and the available stove pages.',
    links: [
      { label: 'Equipment overview', href: '/equipment/' },
      { label: 'Stoves', href: '/equipment/stoves/' },
      { label: 'Chiller', href: '/equipment/chiller/' },
    ],
  },
  {
    title: 'Restaurant',
    icon: 'R',
    description: 'Find staffing, furniture, and customization information.',
    links: [
      { label: 'Workers', href: '/workers/' },
      { label: 'Furniture', href: '/furniture/' },
      { label: 'Decorations', href: '/decorations/' },
    ],
  },
  {
    title: 'Updates',
    icon: 'U',
    description: 'Read update summaries and find the Wiki pages connected to each release.',
    links: [
      { label: 'All updates', href: '/updates/' },
      { label: 'Decorations Part 1', href: '/updates/decorations-part-1/' },
    ],
  },
];
---
<BaseLayout pageId="home">
  <HomePortal>
  <section class="hero"><div class="container hero-inner">
    <div><p class="kicker">Independent Roblox game guide</p><h1>Karinderya <em>Wiki</em></h1><p class="lead">Your English-language reference for running the kitchen, learning the systems, and keeping up with Karinderya.</p><div class="hero-actions"><a class="button primary" href="#explore">Explore the wiki</a><a class="button secondary" href="/codes/">Check codes</a></div></div>
    <ResponsiveImage image={siteImages.homeHero} priority sizes="(max-width: 700px) calc(100vw - 32px), 42vw" class="home-hero-image" />
  </div></section>
  <div class="container"><AdSlot placement="top" /></div>
  <section class="section start-section" aria-labelledby="start-heading"><div class="container">
    <div class="section-heading"><div><p class="section-kicker">New to Karinderya?</p><h2 id="start-heading">Start Here</h2><p>Follow a simple path from your first service loop to restaurant upgrades and customization.</p></div><a href="/guides/">View all guides <span aria-hidden="true">→</span></a></div>
    <ol class="journey-list">{startHere.map((item) => <li><a href={item.href}><span>{item.step}</span><div><h3>{item.title}</h3><p>{item.description}</p></div><b aria-hidden="true">→</b></a></li>)}</ol>
  </div></section>
  <section class="section update-section"><div class="container content-layout">
    <div class="main-column"><div class="section-heading"><div><p class="section-kicker">Update history</p><h2>Recent Documented Update</h2></div><a href="/updates/">All updates <span aria-hidden="true">→</span></a></div><article class="feature-card"><div><span>Update record</span><h3>Decorations Pt. 1</h3><p>Read the dated update summary and follow links to the related Wiki topics.</p></div><a href="/updates/decorations-part-1/">View update summary <span aria-hidden="true">→</span></a></article><AdSlot placement="content-1" /></div>
    <aside class="sidebar"><div class="section-heading"><div><p class="section-kicker">Player help</p><h2>Codes Guide</h2></div></div><div class="code-card"><span class="code-icon">%</span><div><strong>Redemption Guide</strong><p>Find code-entry help and troubleshooting tips.</p></div></div><a class="sidebar-link" href="/codes/">Open Codes Guide <span aria-hidden="true">→</span></a><AdSlot placement="desktop-sidebar" /></aside>
  </div></section>
  <section class="section explore-section" id="explore"><div class="container"><div class="section-heading"><div><p class="section-kicker">Explore the game</p><h2>Build your restaurant knowledge</h2><p>Browse game topics, systems, and practical player guides.</p></div></div><div class="card-grid topic-grid">{categories.map((card) => <WikiCard {...card} />)}</div></div></section>
  <div class="container"><AdSlot placement="content-2" /></div>
  <section class="section guides-section"><div class="container"><div class="section-heading"><div><p class="section-kicker">Helpful reads</p><h2>Useful Guides</h2></div><a href="/guides/">Browse guides <span aria-hidden="true">→</span></a></div><div class="card-grid">{guides.map((card) => <WikiCard {...card} />)}</div></div></section>
  <section class="section directory-section" aria-labelledby="directory-heading"><div class="container"><div class="section-heading"><div><p class="section-kicker">Browse the wiki</p><h2 id="directory-heading">Wiki Directory</h2><p>Jump directly to guides, game systems, restaurant content, and updates.</p></div></div><div class="directory-grid">{wikiDirectory.map((group) => <section class="directory-card"><div class="directory-title"><span aria-hidden="true">{group.icon}</span><div><h3>{group.title}</h3><p>{group.description}</p></div></div><ul>{group.links.map((link) => <li><a href={link.href}>{link.label}<span aria-hidden="true">→</span></a></li>)}</ul></section>)}</div></div></section>
  <section class="section latest-section"><div class="container"><div class="section-heading"><div><p class="section-kicker">More to explore</p><h2>Selected Wiki Pages</h2></div></div><div class="latest-list"><a href="/updates/decorations-part-1/"><span>Decorations Part 1</span><small>Update overview</small><b aria-hidden="true">→</b></a><a href="/guides/restaurant-layout/"><span>Restaurant Layout</span><small>Dining and work-area planning</small><b aria-hidden="true">→</b></a><a href="/ingredients/rice/"><span>Rice</span><small>Ingredient profile</small><b aria-hidden="true">→</b></a></div><AdSlot placement="bottom" /></div></section>
  </HomePortal>
</BaseLayout>
<style>
  .hero { overflow: hidden; padding: clamp(64px, 8vw, 104px) 0 72px; border-bottom: 1px solid #ead8c9; background: radial-gradient(circle at 78% 44%, #ffddbd 0, #fff2e5 28%, transparent 56%), linear-gradient(135deg, #fffaf5, #f6ece3); }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr); align-items: center; gap: clamp(44px, 6vw, 84px); }
  .kicker,.section-kicker { margin: 0 0 10px; color: var(--accent-dark); font-size: .72rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(3rem, 6vw, var(--v2-text-display)); line-height: .98; letter-spacing: -.045em; font-weight: 850; } h1 em { color: var(--accent); font-style: normal; }
  .lead { max-width: 650px; margin: 24px 0 0; color: var(--muted); font-size: clamp(1.05rem,2vw,1.24rem); line-height: 1.68; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .button { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; padding: 12px 20px; border-radius: 12px; font-size: .92rem; font-weight: 780; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .button:hover { transform: translateY(-1px); }
  .primary { color: white; background: var(--accent); } .secondary { color: var(--ink); border: 1px solid var(--border); background: var(--surface); }
  :global(.home-hero-image) { overflow: hidden; border: 1px solid #efcfb3; border-radius: 22px; background: var(--surface); box-shadow: var(--shadow); }
  :global(.home-hero-image img) { aspect-ratio: 16 / 9; object-fit: cover; }
  .content-layout { display: grid; grid-template-columns: minmax(0,1fr) 340px; gap: 28px; }.update-section { padding-top: 72px; }
  .start-section { padding: 66px 0 32px; }
  .journey-list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; counter-reset: journey; }
  .journey-list li { min-width: 0; }
  .journey-list a { height: 100%; min-height: 184px; display: flex; flex-direction: column; gap: 14px; padding: 22px; border: 1px solid var(--border); border-radius: 16px; color: var(--ink); background: var(--surface); text-decoration: none; box-shadow: var(--v2-shadow-card); transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .journey-list a:hover { transform: translateY(-2px); border-color: #dec3b4; box-shadow: var(--shadow); }
  .journey-list a > span { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 10px; color: var(--accent-dark); background: var(--accent-soft); font-size: .73rem; font-weight: 800; }
  .journey-list h3 { margin: 0; font-size: 1.02rem; }
  .journey-list p { margin: 8px 0 0; color: var(--muted); font-size: .86rem; line-height: 1.58; }
  .journey-list b { margin-top: auto; color: var(--accent); }
  .feature-card { min-height: 254px; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(30px,4vw,44px); border-radius: 22px; color: white; background: linear-gradient(135deg,#43291f,#793921); box-shadow: 0 18px 46px rgba(58,31,20,.16); }.feature-card span { color: #ffceb4; font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }.feature-card h3 { margin: 12px 0; font-size: clamp(1.55rem,3vw,2.35rem); }.feature-card p { margin: 0; color: #eadbd3; font-size: 1rem; }.feature-card a { min-height: 44px; display: inline-flex; align-items: center; gap: 8px; margin-top: 24px; color: white; font-weight: 750; text-decoration: none; }
  .sidebar { padding: 26px; border: 1px solid var(--border); border-radius: 22px; background: var(--surface); box-shadow: var(--v2-shadow-card); }.code-card { display: flex; gap: 14px; padding: 18px; border-radius: 14px; background: var(--accent-soft); }.code-icon { width: 38px; height: 38px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 10px; color: white; background: var(--accent); font-weight: 800; }.code-card p { margin: 4px 0 0; color: var(--muted); font-size: .82rem; }.sidebar-link { min-height: 46px; display: flex; align-items: center; gap: 7px; color: var(--accent-dark); font-size: .84rem; font-weight: 750; text-decoration: none; }
  .explore-section { margin-top: 28px; padding: 82px 0; background: var(--v2-surface-muted); }.guides-section { background: #fffdf9; }.latest-list { border-top: 1px solid var(--border); }.latest-list a { display: grid; grid-template-columns: 1fr 1fr auto; align-items: center; gap: 20px; padding: 19px 7px; border-bottom: 1px solid var(--border); color: var(--ink); text-decoration: none; }.latest-list small { color: var(--muted); }.latest-list b { color: var(--accent); }
  .directory-section { padding: 80px 0; background: #fff8f1; }
  .directory-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .directory-card { min-width: 0; padding: 26px; border: 1px solid var(--border); border-radius: 18px; background: var(--surface); box-shadow: var(--v2-shadow-card); }
  .directory-title { display: flex; gap: 12px; }
  .directory-title > span { width: 40px; height: 40px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 11px; color: var(--accent-dark); background: var(--accent-soft); font-weight: 800; }
  .directory-card h3 { margin: 1px 0 0; }
  .directory-card p { margin: 8px 0 0; color: var(--muted); font-size: .87rem; line-height: 1.58; }
  .directory-card ul { margin: 18px 0 0; padding: 0; border-top: 1px solid var(--border); list-style: none; }
  .directory-card li { border-bottom: 1px solid var(--border); }
  .directory-card a { min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--ink); font-size: .84rem; font-weight: 700; text-decoration: none; }
  .directory-card a span { color: var(--accent); }
  .directory-card a:hover { color: var(--accent-dark); }
  @media (max-width:1100px) { .hero-inner { grid-template-columns: minmax(0, 1fr) minmax(320px, .8fr); }.journey-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }.directory-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width:900px) { .content-layout { grid-template-columns: 1fr; }.sidebar { grid-row: 2; } }
  @media (max-width:700px) { .hero { padding: 46px 0 50px; }.hero-inner { grid-template-columns: 1fr; gap: 32px; }.journey-list { grid-template-columns: 1fr; }.journey-list a { min-height: 0; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; }.journey-list b { margin-top: 0; }.directory-grid { grid-template-columns: 1fr; } }
  @media (max-width:520px) { .latest-list a { grid-template-columns: 1fr auto; }.latest-list small { display:none; } }
</style>
