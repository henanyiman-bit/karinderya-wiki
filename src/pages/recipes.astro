<ContentPage
  title="Karinderya Recipes & Orders"
  seoTitle="Karinderya Recipes Guide & Cooking Flow | Karinderya Wiki"
  description="Learn how Recipes connect ingredients, cooking, and food orders in Karinderya with beginner-friendly guides and restaurant workflow tips."
  kicker="Recipe hub"
