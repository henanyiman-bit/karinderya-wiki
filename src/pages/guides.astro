const cards = [
  { title: 'Beginner Guide', description: 'Learn the service loop, ingredient stocking, upgrades, and progression basics.', href: '/guides/beginner-guide/', icon: '1' },
  { title: '5-Star Guide', description: 'Build a smoother restaurant while working toward the five-star goal.', href: '/guides/5-star-guide/', icon: '5' },
  { title: 'Counter Upgrades', description: 'Compare Default, RedWood, and ElegantWood counter options.', href: '/guides/counter-upgrades/', icon: 'C' },
