---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticle from '../../components/v2/templates/GuideArticle.astro';
import FAQ from '../../components/FAQ.astro';
import { siteImages } from '../../data/images';
import { getPageSEO } from '../../utils/seo';

const faqItems = [
  { question: 'Is Counter Upgrade a confirmed Karinderya feature name?', answer: 'Dated Decorations Part 1 records use the term Counter Upgrade. The current options and exact controls still need to be read from the live game interface.' },
  { question: 'Does changing a Counter improve restaurant performance?', answer: 'No reliable evidence reviewed for this guide establishes a speed, income, rating, or capacity bonus.' },
  { question: 'Where can I browse related customization pages?', answer: 'Use the Decorations Hub for Tiles, Counters, and other connected topics.' },
];
---

<BaseLayout pageId="guides-counter-upgrades" breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Guides', href: '/guides/' }, { label: getPageSEO('guides-counter-upgrades').h1 }]}>
<GuideArticle
  title={getPageSEO('guides-counter-upgrades').h1}
  kicker="Decorations guide"
  intro="Dated update records mention a Counter Upgrade feature, but current options and effects require confirmation in the game interface."
  tableOfContents
  heroImage={siteImages.decorationsHero}
  relatedLinks={[
    { label: 'Decorations', href: '/decorations/', description: 'Browse restaurant customization categories.' },
    { label: 'Tiles', href: '/decorations/tiles/', description: 'Review the Tiles customization directory.' },
    { label: 'Furniture Hub', href: '/furniture/', description: 'Explore Furniture categories and dining-area planning.' },
    { label: 'Restaurant Layout Guide', href: '/guides/restaurant-layout/', description: 'Coordinate work areas and movement routes.' },
  ]}
>
  <h2 id="direct-answer">Direct Answer</h2>
  <p>Counter Upgrade is named in dated Decorations Part 1 records. Those records do not establish a permanent menu, option list, price, or performance effect, so this guide does not provide fixed upgrade steps.</p>

  <h2 id="overview">Overview</h2>
  <p>The Counter topic belongs to restaurant customization and workspace organization. It is separate from the Stove directory and is not treated here as a cooking-equipment progression system.</p>

  <h2 id="confirmed-information">What Is Currently Supported</h2>
  <p>The feature name is supported by dated update reporting. To make a change, locate the Counter-related interaction available in the current version and follow only the prompts shown there.</p>

  <h2 id="unconfirmed-information">What Is Not Yet Confirmed</h2>
  <ul><li>The current interaction location and exact menu labels.</li><li>The complete list of Counter options.</li><li>Permanent purchase terms or delivery behavior.</li><li>Any effect on cooking, customer behavior, rating, or income.</li></ul>

  <h2 id="gameplay-tips">Gameplay Tips</h2>
  <ul>
    <li>Keep the Counter area easy to identify during restaurant service.</li>
    <li>Coordinate customization with nearby Furniture and Equipment.</li>
    <li>Change one visual area at a time.</li>
    <li>Use the Decorations Hub to navigate related customization topics.</li>
  </ul>

  <h2 id="common-mistakes">Common Mistakes</h2>
  <ul>
    <li>Choosing appearance without considering the surrounding workspace.</li>
    <li>Changing several layout elements before reviewing the result.</li>
    <li>Assuming the current interface matches an earlier game version.</li>
    <li>Letting customization hide a frequently used interaction.</li>
  </ul>

  <FAQ slot="faq" items={faqItems} />
</GuideArticle>
</BaseLayout>
