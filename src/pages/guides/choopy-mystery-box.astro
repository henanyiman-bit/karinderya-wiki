---
import ContentPage from '../../components/ContentPage.astro';
import VerificationStatus from '../../components/VerificationStatus.astro';
---
<ContentPage title="Karinderya Choopy Mystery Box Guide" description="Review the observed Normal Choopy Mystery Box price, delivery time, and random reward behavior." kicker="Decorations guide" intro="A short reference for the publicly observed Normal Choopy delivery option." parent={{ label: 'Guides', href: '/guides/' }} relatedLinks={[{ label: 'Decorations', href: '/decorations/' }, { label: 'Tiles', href: '/decorations/tiles/' }, { label: 'Counter upgrades', href: '/guides/counter-upgrades/' }]} sourceIds={['wiki-decorations']}>
  <VerificationStatus status="Reported" notes="The Normal listing and delivery estimate appear in one retained community guide with public gameplay captures. Availability and timing may change." />
  <h2>Observed Normal box details</h2>
  <div class="table-scroll"><table><tbody>
    <tr><th scope="row">Observed price</th><td>&#8369;10,000</td></tr>
    <tr><th scope="row">Observed delivery time</th><td>5 minutes</td></tr>
    <tr><th scope="row">Reward</th><td>Random / mystery reward</td></tr>
  </tbody></table></div>
  <p class="notice">No complete reward table is published here because the possible reward pool has not been sufficiently verified.</p>
</ContentPage>
