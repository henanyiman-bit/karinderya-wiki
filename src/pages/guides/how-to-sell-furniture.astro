---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticle from '../../components/v2/templates/GuideArticle.astro';
import FAQ from '../../components/FAQ.astro';
import { siteImages } from '../../data/images';
import { getPageSEO } from '../../utils/seo';

const faqItems = [
  { question: 'Can you sell furniture in Karinderya?', answer: 'This Wiki has not found reliable current evidence for a furniture-selling control, supported item list, or resale rule. Do not rely on an older guide that promises a sale option.' },
  { question: 'What should I do with unwanted furniture?', answer: 'Open the current furniture or editing interface and use only the actions it actually shows. Moving or replacing an item should not be assumed available unless the current interface offers it.' },
  { question: 'Where can I browse furniture information?', answer: 'Use the Furniture Hub and Tables directory for the entries currently covered by the Wiki.' },
];
---

<BaseLayout pageId="guides-how-to-sell-furniture" breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Guides', href: '/guides/' }, { label: getPageSEO('guides-how-to-sell-furniture').h1 }]}>
<GuideArticle
  title={getPageSEO('guides-how-to-sell-furniture').h1}
  kicker="Furniture management guide"
  intro="Reliable current evidence for selling furniture in Karinderya has not been established. Check the actions shown by your current furniture interface."
  tableOfContents
  heroImage={siteImages.furnitureHero}
  relatedLinks={[
    { label: 'Furniture Hub', href: '/furniture/', description: 'Browse Furniture categories and planning guidance.' },
    { label: 'Tables', href: '/furniture/tables/', description: 'Open the Tables directory and individual entries.' },
    { label: 'Chairs', href: '/furniture/chairs/', description: 'Review Chairs as part of the dining area.' },
    { label: 'Restaurant Layout Guide', href: '/guides/restaurant-layout/', description: 'Plan dining, kitchen, and movement areas.' },
  ]}
>
  <h2 id="direct-answer">Direct Answer</h2>
  <p>This Wiki has not found reliable current evidence that establishes a furniture-selling feature, its location, eligible items, or resale terms. The URL is retained because players search for this task, but this page does not provide unsupported sale steps.</p>

  <h2 id="current-answer">Evidence Boundary</h2>
  <p>Third-party pages make conflicting claims about selling furniture. The material reviewed for this rebuild did not include a creator-owned instruction or a current, reviewable game capture showing the complete sale flow. Until that evidence exists, treat the feature as unconfirmed.</p>

  <h2 id="manage-furniture">How Furniture Can Be Managed</h2>
  <p>Open the furniture or editing controls available in your current game and read the actions shown for the selected item. Do not assume that Move, Store, Replace, or Sell exists unless that action appears in the interface.</p>

  <h2 id="unwanted-furniture">What to Do With Unwanted Furniture</h2>
  <p>First check the selected item’s current controls. If no removal or sale action is shown, do not follow a third-party sequence that assumes one. Use the <a href="/furniture/">Furniture Hub</a> to review the category and the <a href="/guides/restaurant-layout/">Restaurant Layout Guide</a> when reorganizing the surrounding space.</p>

  <h2 id="common-confusion">Common Confusion</h2>
  <p>A search result or older video can describe a version-specific control as permanent. A visible item value also does not prove that the item can be sold. Use the actions in the current game as the deciding evidence.</p>

  <FAQ slot="faq" items={faqItems} />
</GuideArticle>
</BaseLayout>
