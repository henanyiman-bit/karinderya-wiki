---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb, { type BreadcrumbItem } from '../components/Breadcrumb.astro';
import GoogleIntegrations from '../components/GoogleIntegrations.astro';

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
  ogImage?: string;
}

const { title, seoTitle, description, breadcrumbs = [], noindex = false, ogImage } = Astro.props;
const siteName = 'Karinderya Wiki';
const fullTitle = seoTitle ?? (title === siteName ? title : `${title} | ${siteName}`);
const siteURL = Astro.site ?? new URL('https://karinderya.ymmyi.wiki');
const pathWithoutSlashes = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const canonicalPath = pathWithoutSlashes ? `/${pathWithoutSlashes}/` : '/';
const canonicalURL = new URL(canonicalPath, siteURL);
const ogImageURL = ogImage ? new URL(ogImage, siteURL) : undefined;
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href ?? canonicalPath, siteURL).href,
  })),
} : null;
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteURL.href}#website`,
      url: siteURL.href,
      name: siteName,
      inLanguage: 'en',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: fullTitle,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${siteURL.href}#website` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <GoogleIntegrations />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      {breadcrumbs.length > 0 && <div class="container"><Breadcrumb items={breadcrumbs} /></div>}
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --font-heading: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-body: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --ink: #2d2622;
    --muted: #71655e;
    --accent: #c6532e;
    --accent-dark: #9f3b1e;
    --accent-soft: #fff0e8;
    --gold: #df9d37;
    --page: #f8f5f1;
    --surface: #fffdfa;
    --border: #eadfd7;
    --radius: 16px;
    --shadow: 0 14px 40px rgb(72 45 28 / 9%);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { min-width: 0; margin: 0; color: var(--ink); background: var(--page); font-family: var(--font-body); line-height: 1.65; text-rendering: optimizeLegibility; }
  img, svg { display: block; max-width: 100%; }
  button, input, textarea { font: inherit; }
  a { text-underline-offset: 3px; }
  a, button, input, textarea, summary { outline-offset: 3px; }
  :focus-visible { outline: 3px solid #2869a8; }
  h1, h2, h3 { font-family: var(--font-heading); line-height: 1.15; letter-spacing: -.025em; }
  h1 { font-size: clamp(2.25rem, 6vw, 4.7rem); }
  h2 { font-size: clamp(1.45rem, 3vw, 2rem); }
  .container { width: min(1180px, calc(100% - 32px)); margin-inline: auto; }
  .narrow { width: min(780px, calc(100% - 32px)); margin-inline: auto; }
  .section { padding: 32px 0; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
  .section-heading h2 { margin: 0; }
  .section-heading p { max-width: 580px; margin: 7px 0 0; color: var(--muted); font-size: .9rem; }
  .section-heading > a { min-height: 44px; flex: 0 0 auto; display: inline-flex; align-items: center; color: var(--accent-dark); font-size: .82rem; font-weight: 700; text-decoration: none; }
  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .page-hero { padding: 28px 0 30px; }
  .page-hero .kicker { margin: 0 0 9px; color: var(--accent-dark); font-size: .73rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .page-hero h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.4rem); }
  .page-hero .lead { max-width: 720px; margin: 14px 0 0; color: var(--muted); font-size: clamp(1rem, 2vw, 1.13rem); }
  .content-panel { padding: clamp(22px, 4vw, 36px); border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .content-panel h2:first-child { margin-top: 0; }
  .content-panel h2 { margin-top: 32px; }
  .content-panel p, .content-panel li { color: var(--muted); }
  .content-panel, .wiki-card, main p, main li { overflow-wrap: anywhere; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 10px 12px; border: 1px solid var(--border); text-align: left; vertical-align: top; }
  .notice { padding: 13px 15px; border-left: 3px solid var(--gold); border-radius: 6px 10px 10px 6px; color: #6d552d; background: #fff8e9; font-size: .86rem; }
  .skip-link { position: fixed; top: 8px; left: 8px; z-index: 100; padding: 8px 12px; color: white; background: var(--accent-dark); transform: translateY(-160%); }
  .skip-link:focus { transform: translateY(0); }
  @media (max-width: 820px) { .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } table { display: block; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; } }
  @media (max-width: 560px) { .card-grid { grid-template-columns: 1fr; } .section-heading { align-items: start; flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition-duration: .01ms !important; } }
</style>
