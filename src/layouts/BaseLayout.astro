---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb, { type BreadcrumbItem } from '../components/Breadcrumb.astro';
import GoogleIntegrations from '../components/GoogleIntegrations.astro';
import { siteImages, entityImages, type ResponsiveImageAsset } from '../data/images';
import { getPageSEO } from '../utils/seo';
import { footerNavigation } from '../utils/navigation';

interface Props {
  pageId?: string;
  title?: string;
  seoTitle?: string;
  description?: string;
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
  ogImage?: string;
}

const { pageId, title, seoTitle, description, breadcrumbs = [], noindex = false, ogImage } = Astro.props;
const siteName = 'Karinderya Wiki';
const registrySEO = pageId ? getPageSEO(pageId) : undefined;
const legacyTitle = title?.trim();
const legacyDescription = description?.trim();

if (!registrySEO && !legacyTitle) {
  throw new Error('BaseLayout requires either a registered pageId or a title.');
}

if (!registrySEO && !legacyDescription) {
  throw new Error('BaseLayout requires either a registered pageId or a description.');
}

const fullTitle = registrySEO?.title ?? seoTitle ?? (legacyTitle === siteName ? legacyTitle : `${legacyTitle} | ${siteName}`);
const resolvedDescription = registrySEO?.description ?? legacyDescription!;
const siteURL = Astro.site ?? new URL('https://karinderya.ymmyi.wiki');
const pathWithoutSlashes = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const legacyCanonicalPath = pathWithoutSlashes ? `/${pathWithoutSlashes}/` : '/';
const canonicalPath = registrySEO?.canonicalPath ?? legacyCanonicalPath;
const canonicalURL = new URL(canonicalPath, siteURL);
const imageRegistry: Record<string, ResponsiveImageAsset> = { ...siteImages, ...entityImages };
const registryImage = registrySEO?.ogImageKey ? imageRegistry[registrySEO.ogImageKey] : undefined;
const resolvedOgImage = registrySEO ? registryImage?.webp.at(-1)?.src ?? registryImage?.fallback : ogImage;
const ogImageURL = resolvedOgImage ? new URL(resolvedOgImage, siteURL) : undefined;
const resolvedNoindex = registrySEO ? !registrySEO.indexable : noindex;
const resolvedOgType = registrySEO?.ogType ?? 'website';
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href ?? canonicalPath, siteURL).href,
  })),
} : null;
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteURL.href}#website`,
      url: siteURL.href,
      name: siteName,
      inLanguage: 'en',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: fullTitle,
      description: resolvedDescription,
      inLanguage: 'en',
      isPartOf: { '@id': `${siteURL.href}#website` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {resolvedNoindex && <meta name="robots" content="noindex, follow" />}
    <GoogleIntegrations />

    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      {breadcrumbs.length > 0 && <div class="container"><Breadcrumb items={breadcrumbs} /></div>}
      <slot />
    </main>
    <Footer navigation={footerNavigation} />
  </body>
</html>

<style is:global>
  :root {
    --font-heading: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-body: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --ink: #2c211c;
    --muted: #6d5f57;
    --accent: #c6532e;
    --accent-dark: #9f3b1e;
    --accent-soft: #fff0e8;
    --gold: #df9d37;
    --page: #faf7f3;
    --surface: #fffdfa;
    --surface-muted: #f3ece6;
    --border: #e7d9cf;
    --radius: 18px;
    --shadow: 0 16px 42px rgb(72 45 28 / 9%);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { min-width: 0; margin: 0; color: var(--ink); background: var(--page); font-family: var(--font-body); font-size: 16px; line-height: 1.68; text-rendering: optimizeLegibility; }
  img, svg { display: block; max-width: 100%; }
  button, input, textarea { font: inherit; }
  a { text-underline-offset: 3px; }
  a, button, input, textarea, summary { outline-offset: 3px; }
  :focus-visible { outline: 3px solid #2869a8; }
  h1, h2, h3 { font-family: var(--font-heading); line-height: 1.15; letter-spacing: -.025em; }
  h1 { font-size: clamp(2.35rem, 5vw, 4.8rem); }
  h2 { font-size: clamp(1.55rem, 2.5vw, 2.2rem); }
  h3 { font-size: clamp(1.08rem, 1.5vw, 1.35rem); }
  .container { width: min(1240px, calc(100% - 48px)); margin-inline: auto; }
  .narrow { width: min(820px, calc(100% - 48px)); margin-inline: auto; }
  .section { padding: 52px 0; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 26px; }
  .section-heading h2 { margin: 0; }
  .section-heading p { max-width: 640px; margin: 9px 0 0; color: var(--muted); font-size: .98rem; line-height: 1.6; }
  .section-heading > a { min-height: 44px; flex: 0 0 auto; display: inline-flex; align-items: center; gap: 7px; color: var(--accent-dark); font-size: .9rem; font-weight: 750; text-decoration: none; }
  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .page-hero { padding: 28px 0 30px; }
  .page-hero .kicker { margin: 0 0 9px; color: var(--accent-dark); font-size: .73rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .page-hero h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.4rem); }
  .page-hero .lead { max-width: 720px; margin: 14px 0 0; color: var(--muted); font-size: clamp(1rem, 2vw, 1.13rem); }
  .content-panel { padding: clamp(24px, 4vw, 42px); border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); box-shadow: 0 8px 28px rgb(72 45 28 / 5%); }
  .content-panel h2:first-child { margin-top: 0; }
  .content-panel h2 { margin-top: 42px; }
  .content-panel p, .content-panel li { color: var(--muted); }
  .content-panel, .wiki-card, main p, main li { overflow-wrap: anywhere; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 13px 15px; border: 1px solid var(--border); text-align: left; vertical-align: top; }
  th { background: var(--surface-muted); font-size: .86rem; letter-spacing: .02em; }
  .notice { padding: 13px 15px; border-left: 3px solid var(--gold); border-radius: 6px 10px 10px 6px; color: #6d552d; background: #fff8e9; font-size: .86rem; }
  .skip-link { position: fixed; top: 8px; left: 8px; z-index: 100; padding: 8px 12px; color: white; background: var(--accent-dark); transform: translateY(-160%); }
  .skip-link:focus { transform: translateY(0); }
  main:focus { outline: none; }
  @media (max-width: 820px) { .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } table { display: block; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; } }
  @media (max-width: 560px) { .container, .narrow { width: calc(100% - 32px); } .section { padding: 38px 0; } .card-grid { grid-template-columns: 1fr; } .section-heading { align-items: start; flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition-duration: .01ms !important; } }
</style>
